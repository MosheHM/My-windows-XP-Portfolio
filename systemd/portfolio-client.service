[Unit]
Description=Portfolio Client Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10s
WorkingDirectory=/opt/portfolio
ExecStartPre=-/usr/bin/docker stop portfolio-client
ExecStartPre=-/usr/bin/docker rm portfolio-client
ExecStart=/usr/bin/docker run --rm \
    --name portfolio-client \
    -p 3000:80 \
    --network portfolio-network \
    portfolio-client:latest
ExecStop=/usr/bin/docker stop portfolio-client

[Install]
WantedBy=multi-user.target
