[Unit]
Description=Portfolio File Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10s
WorkingDirectory=/opt/portfolio
ExecStartPre=-/usr/bin/docker stop portfolio-file-service
ExecStartPre=-/usr/bin/docker rm portfolio-file-service
ExecStart=/usr/bin/docker run --rm \
    --name portfolio-file-service \
    -p 8001:8001 \
    -v portfolio-files:/data/files \
    -v portfolio-metadata:/data/metadata \
    --network portfolio-network \
    portfolio-file-service:latest
ExecStop=/usr/bin/docker stop portfolio-file-service

[Install]
WantedBy=multi-user.target
