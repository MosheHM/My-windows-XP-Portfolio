[Unit]
Description=Portfolio LLM Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10s
WorkingDirectory=/opt/portfolio
ExecStartPre=-/usr/bin/docker stop portfolio-llm-service
ExecStartPre=-/usr/bin/docker rm portfolio-llm-service
ExecStart=/usr/bin/docker run --rm \
    --name portfolio-llm-service \
    -p 8000:8000 \
    -v portfolio-llm-data:/app/data \
    --network portfolio-network \
    portfolio-llm-service:latest
ExecStop=/usr/bin/docker stop portfolio-llm-service

[Install]
WantedBy=multi-user.target
